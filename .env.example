# ============================================================
#  JbrainTrader 환경 변수 예시
#
#  이 파일을 프로젝트 루트에 .env 로 복사한 뒤 값을 채우세요.
#     copy .env.example .env
#
#  .env 는 .gitignore 에 등록되어 있습니다. 절대 커밋하지 마세요.
#  (선택) 표시가 없는 항목은 기본 기능에 필요한 값입니다.
# ============================================================


# ------------------------------------------------------------
#  MySQL (core/database.py)  — 시세·거래 데이터 저장
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=jbuser
DB_PASSWORD=CHANGE_ME
DB_NAME=jbstock


# ------------------------------------------------------------
#  키움증권 자동 로그인 (auto_login/config.py)
#
#  아래 값은 평문이 아니라 secret.key 로 암호화된 문자열입니다.
#  다음 명령을 실행하면 아이디/비밀번호를 입력받아 암호화된 값을 출력합니다.
#     python auto_login/encrypt_utils.py
#  출력된 문자열을 그대로 붙여 넣으세요. secret.key 도 커밋 금지입니다.
# ------------------------------------------------------------
KIWOOM_USER_ID=
KIWOOM_USER_PW=
KIWOOM_CERT_PW=
# (선택) 계좌 비밀번호. 비워두면 KIWOOM_USER_PW 를 사용합니다.
KIWOOM_ACC_PW=
# 1: 모의투자 서버, 0: 실거래 서버  — 검증이 끝나기 전에는 1 을 유지하세요.
KIWOOM_IS_MOCK=1


# ------------------------------------------------------------
#  한국투자증권 KIS Developers (선택, core/broker/kis.py, export/*.py)
#  https://apiportal.koreainvestment.com 에서 발급
# ------------------------------------------------------------
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=
# 계좌번호: 12345678-01 형식 (또는 8~10자리 숫자)
KIS_ACC_NO=
KIS_MOCK_ACC_NO=
# (선택) KISBroker 를 키 지정 없이 직접 생성할 때 쓰는 기본 키. 보통은 REAL/MOCK 항목만 채우면 됩니다.
KIS_APP_KEY=
KIS_APP_SECRET=


# ------------------------------------------------------------
#  바이낸스 (선택, core/broker/binance.py)
#  현물/선물 키를 따로 쓰면 SPOT_/FUTURES_ 항목을, 하나만 쓰면 기본 항목을 채우세요.
# ------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SPOT_API_KEY=
BINANCE_SPOT_API_SECRET=
BINANCE_FUTURES_API_KEY=
BINANCE_FUTURES_API_SECRET=


# ------------------------------------------------------------
#  Discord 봇 (선택, backend/main.py 알림 전송)
#  봇 자체 실행용 설정은 discord_bot/.env.example 을 참고하세요.
#  서버(Guild)·채널 ID: Discord 개발자 모드 ON → 우클릭 → ID 복사
# ------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_LOG_CHANNEL_ID=
DISCORD_CMD_CHANNEL_ID=


# ------------------------------------------------------------
#  구글 시트 매매일지 업로드 (선택, core/service/gsheet_exporter.py)
#  설정 절차: docs/guide/구글시트_매매일지_설정.md
# ------------------------------------------------------------
# 구글 서비스 계정 JSON 경로 (secret/ 폴더는 커밋 제외)
GSHEET_CREDENTIALS_PATH=secret/gsheet_service_account.json
# 스프레드시트 URL 의 /d/ 와 /edit 사이 문자열
GSHEET_SPREADSHEET_ID=
# (선택) 해외 주식 전용 스프레드시트. 비우면 국내 시트를 함께 사용
GSHEET_SPREADSHEET_ID_OVERSEAS=


# ------------------------------------------------------------
#  엔진 동작 옵션 (선택, backend/main.py)
# ------------------------------------------------------------
# 1 이면 Flask 디버그 모드
JBRAIN_DEBUG=0
# 1 이면 엔진 재시작 시 마지막 연결 정보로 키움 자동 재연결
JBRAIN_AUTO_RECONNECT=1
# REST API 바인드 주소. 모바일 앱 등 LAN 접속이 필요 없으면 127.0.0.1 권장
BACKEND_HOST=0.0.0.0
# 도우미 마스코트 채팅에 사용할 Claude CLI 모델 별칭 (haiku / sonnet / opus)
JBRAIN_CHAT_MODEL=haiku


# ------------------------------------------------------------
#  Claude CLI 작업 기록 훅 (선택, cli_hook_prompt.py / cli_hook_stop.py)
#  설명: docs/guide/cli_integration.md
# ------------------------------------------------------------
# 훅이 결과를 보낼 엔진 주소
JBRAIN_BASE_URL=http://localhost:5000
# 기록에 표시할 CLI 종류 (claude_cli / antigravity_cli 등)
JBRAIN_TRIGGER_TYPE=claude_cli
