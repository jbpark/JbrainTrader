# Discord Bot 환경 설정
# 이 파일을 .env 로 복사한 후 각 값을 채워주세요.
# cp .env.example .env

# ─── 필수 설정 ───────────────────────────────
# Discord Bot Token (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Discord 서버(Guild) ID
# 서버 설정 → 개발자 모드 ON → 서버 아이콘 우클릭 → ID 복사
DISCORD_GUILD_ID=YOUR_GUILD_ID_HERE

# ─── 채널 ID ─────────────────────────────────
# Log 채널 ID (엔진 로그 메시지 출력용)
DISCORD_LOG_CHANNEL_ID=YOUR_LOG_CHANNEL_ID_HERE

# Command 채널 ID (/portfolio 를 사용할 채널)
DISCORD_CMD_CHANNEL_ID=YOUR_CMD_CHANNEL_ID_HERE

# ─── 백엔드 API ───────────────────────────────
# 64bit 엔진 Flask 서버 주소
API_BASE_URL=http://localhost:5000
