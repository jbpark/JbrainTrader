# 줄바꿈 정규화: 저장소에는 항상 LF로 저장, 체크아웃 시에도 LF 유지
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF 유지 (cmd.exe는 LF만 있는 배치 파일에서 오동작할 수 있음)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 바이너리 파일 (줄바꿈 변환 금지)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.parquet binary
*.xlsx binary
*.jar binary
*.apk binary
*.keystore binary
*.jks binary
*.pdf binary
